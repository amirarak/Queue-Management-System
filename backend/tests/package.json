{
  "name": "university-queue-tests",
  "version": "1.0.0",
  "description": "Test suite for University Service Center Automation System",
  "scripts": {
    "test": "jest --coverage --verbose",
    "test:auth": "jest auth.test.js --verbose",
    "test:kiosk": "jest kiosk.test.js --verbose",
    "test:queue": "jest queue.test.js --verbose",
    "test:display": "jest display.test.js --verbose",
    "test:staff": "jest staff.test.js --verbose",
    "test:analytics": "jest analytics.test.js --verbose",
    "test:security": "jest security.test.js --verbose"
  },
  "jest": {
    "rootDir": "..",
    "testMatch": [
      "<rootDir>/tests/**/*.test.js"
    ],
    "testEnvironment": "node",
    "coverageReporters": [
      "text",
      "lcov"
    ],
    "collectCoverageFrom": [
      "src/**/*.js",
      "!src/config/**",
      "!src/models/index.js"
    ]
  },
  "devDependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "helmet": "^7.1.0",
    "jest": "^29.7.0",
    "joi": "^17.11.0",
    "jsonwebtoken": "^9.0.2",
    "supertest": "^6.3.4"
  }
}