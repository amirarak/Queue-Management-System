# Compose runtime settings
APP_PORT=80

# PostgreSQL
POSTGRES_DB=university_queue
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me

# Redis
REDIS_PASSWORD=

# Backend
API_PREFIX=/api
JWT_SECRET=change_this_to_a_minimum_32_character_secret
JWT_EXPIRE=1h
JWT_REFRESH_EXPIRE=7d
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# CORS allow-list (comma-separated origins if needed)
# For IP-only deployment, set your server IP exactly, for example:
# FRONTEND_URL=http://203.0.113.10
FRONTEND_URL=http://SERVER_IP

# Optional SMTP
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@alatoo.edu.kg

# Initial admin account (created on first DB initialization)
ADMIN_EMAIL=admin@alatoo.edu.kg
ADMIN_PASSWORD=ChangeMe123!
ADMIN_FULL_NAME=System Administrator
